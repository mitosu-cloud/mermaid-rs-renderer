flowchart LR
    subgraph HAMI["HAMi — in-process shim, shared kernel"]
        direction TB
        subgraph HC1["Tenant container A"]
            HApp1["App"]
            HShim1["libvgpu.so LD_PRELOAD shim<br/>quota checks run inside<br/>tenant process ⚠"]
        end
        subgraph HC2["Tenant container B"]
            HApp2["App + shim"]
        end
        HKern["Shared host kernel<br/>NVIDIA driver on host"]
        HGPU["GPU — co-resident contexts,<br/>no hardware partition"]
        HNote[/"Boundary: cgroup + honor-system shim<br/>Bypass: dlopen the real libcuda"/]
        HApp1 --> HShim1 --> HKern
        HApp2 --> HKern
        HKern --> HGPU
        HGPU -.- HNote
    end

    subgraph QCUDA["qCUDA — virtio remoting, benign guest"]
        direction TB
        subgraph QVM["Guest VM"]
            QApp["App"]
            QRt["Runtime-API wrapper<br/>misses driver API +<br/>static-linked cudart"]
            QFE["virtio front-end"]
        end
        QEMU["QEMU device emulation<br/>per-call synchronous RPC"]
        QBE["Single backend process<br/>no identity · no validation ·<br/>all clients share fate"]
        QDrv["NVIDIA driver in<br/>HOST kernel ⚠"]
        QGPU["GPU"]
        QNote[/"Boundary: VM wall for the guest,<br/>but a driver bug = host compromise"/]
        QApp --> QRt --> QFE --> QEMU --> QBE --> QDrv --> QGPU
        QGPU -.- QNote
    end

    subgraph IZ["Izuma virtio-cuda + Myriplane — adversarial tenancy"]
        direction TB
        subgraph IVM["Tenant micro-VM (virtual node)"]
            IApp["App"]
            IShim["Synthetic libcuda (driver API)<br/>untrusted — compatibility only"]
        end
        IRing["Static shared-memory rings<br/>async submit · batched completions ·<br/>ioeventfd → irqfd doorbells"]
        subgraph ISVM["GPU Service VM (VFIO)"]
            IW["Per-tenant broker worker<br/>copy-then-validate · capability<br/>firewall · quota · audit · zeroing"]
            IDrv["NVIDIA driver inside<br/>service VM (attested, restartable)"]
        end
        IGPU["GPU — MIG GI per trust domain"]
        INote[/"Identity: hypervisor-bound tenant_id<br/>Placement: Myriplane trust-aware<br/>Blast radius: service VM, not host"/]
        IApp --> IShim --> IRing --> IW --> IDrv --> IGPU
        IGPU -.- INote
    end

